{
  "name": "seriform",
  "version": "1.3.1",
  "description": "Small toolkit for parsing forms to/from query parameters with a nice API",
  "author": "eniallator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eniallator/Seriform.git"
  },
  "homepage": "https://github.com/eniallator/Seriform",
  "bugs": {
    "url": "https://github.com/eniallator/Seriform/issues"
  },
  "keywords": [
    "form",
    "serialization",
    "query-params",
    "typescript",
    "url"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=25.4.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsc",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "findissues": "pnpm typecheck && pnpm lint && pnpm format:check",
    "bump-and-release": "./scripts/bump-and-release.sh",
    "release": "./scripts/release.sh",
    "publint": "publint run",
    "attw": "attw --pack .",
    "check-output": "./scripts/check-output.sh",
    "prepublish": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test && pnpm publint"
  },
  "dependencies": {
    "deep-guards": "^1.4.0",
    "niall-utils": "^2.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.12.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
