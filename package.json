{
  "name": "seriform",
  "version": "2.0.0",
  "description": "Small toolkit for parsing forms to/from query parameters with a nice API",
  "author": "eniallator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eniallator/Seriform.git"
  },
  "homepage": "https://github.com/eniallator/Seriform",
  "bugs": {
    "url": "https://github.com/eniallator/Seriform/issues"
  },
  "keywords": [
    "form",
    "serialization",
    "query-params",
    "typescript",
    "url"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parsers": {
      "types": "./dist/parsers/index.d.ts",
      "import": "./dist/parsers/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=25.4.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "demo:preview": "vite preview demo",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "findissues": "pnpm typecheck && pnpm lint && pnpm format:check",
    "bump-and-release": "./scripts/bump-and-release.sh",
    "release": "./scripts/release.sh",
    "publint": "publint run",
    "attw": "attw --pack .",
    "check-output": "./scripts/check-output.sh",
    "prepublish": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test && pnpm publint"
  },
  "dependencies": {
    "deep-guards": "^1.4.0",
    "niall-utils": "^2.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
